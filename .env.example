# ===================================================
# APIHub Environment Variables Configuration
# Copy this file to .env before starting the services
# ===================================================

# Server Configuration
NODE_ENV=development
PORT=3333
HOST=0.0.0.0

# Frontend Configuration
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3333/api/v1

# Security & Authentication
# Generate a secure 32+ character key for production (e.g., openssl rand -base64 32)
JWT_SECRET=super-secret-development-jwt-key-replace-in-production-min-32-chars
JWT_EXPIRES_IN=7d
COOKIE_SECRET=super-secret-cookie-secret-key-replace-in-production

# CORS
CORS_ORIGIN=http://localhost:3000

# Database Configuration (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/apihub?schema=public"

# API Tester Security Limits
TESTER_TIMEOUT_MS=10000
TESTER_MAX_BODY_BYTES=1048576
TESTER_MAX_RESPONSE_BYTES=5242880
TESTER_ALLOW_PRIVATE_IPS=false
