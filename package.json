{
  "name": "apihub-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "APIHub - Open-source API management platform for organizing, documenting, testing, and monitoring APIs",
  "scripts": {
    "build": "pnpm -r run build",
    "dev:api": "pnpm --filter @apihub/api dev",
    "dev:web": "pnpm --filter @apihub/web dev",
    "test": "pnpm -r run test",
    "lint": "pnpm -r run lint"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild"
    ]
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "prisma": "5.22.0",
    "typescript": "^5.6.3"
  },
  "packageManager": "pnpm@12.21.0",
  "dependencies": {
    "@prisma/client": "5.22.0"
  }
}
